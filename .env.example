# Python Playwright Backend REST API Base URL
# Əgər boş buraxılarsa, lokal development üçün default olaraq "/api" istifadə olunur.
# Nümunə: https://example-backend.com/api və ya http://localhost:8000/api
VITE_API_BASE_URL="https://example-backend.com/api"

# AI Studio Environment Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
